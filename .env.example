# Serper is the only door to the web. Without it, jobs fail.
ARTEMIS_SERPER_API_KEY=

# Optional. Without it, extraction degrades to strict same-sentence matching:
# no referent resolution, no borderline merge assist, and pivot verification
# accepts only shared_page and canonical_url. Every result says so in warnings.
ARTEMIS_ANTHROPIC_API_KEY=

# Models
ARTEMIS_EXTRACTION_MODEL=claude-haiku-4-5
ARTEMIS_VERIFICATION_MODEL=claude-opus-5
ARTEMIS_IDENTITY_MODEL=claude-opus-5

# Budgets (per job; a request body can lower but not silently exceed these)
ARTEMIS_MAX_DEPTH_PER_SIDE=2
ARTEMIS_MAX_NODES_EXPANDED=60
ARTEMIS_MAX_SERPER_CREDITS=150
ARTEMIS_MAX_FETCHES=250
ARTEMIS_MAX_CLAUDE_CALLS=200
ARTEMIS_WALL_CLOCK_S=600

# Structured sources (URL discovery only; results are fetched and grounded
# like any other page). The SEC requires a User-Agent with real contact info.
ARTEMIS_EDGAR_ENABLED=true
ARTEMIS_EDGAR_USER_AGENT=Your Org research@yourdomain.com
ARTEMIS_PROPUBLICA_ENABLED=true
# Free tier: https://opencorporates.com/api_accounts/new — absent means skipped.
OPENCORPORATES_API_TOKEN=

# Politeness
ARTEMIS_FETCH_CONCURRENCY=8
ARTEMIS_PER_DOMAIN_CONCURRENCY=2
ARTEMIS_PER_DOMAIN_DELAY_S=1.0
ARTEMIS_RESPECT_ROBOTS=true

# Return routes whose pivot rests on nothing but a matching name string,
# flagged loudly. Set true to drop them instead.
ARTEMIS_DROP_NAME_ONLY_PIVOTS=false

ARTEMIS_CACHE_DIR=.artemis-cache
